# FallGuard -- camera AI host (NOT the Telegram bot Vercel host)
# Mat khau dang nhap dashboard: >= 12 ky tu, giu bi mat.
FALLGUARD_PASSWORD=

# Domain Production cua Telegram-bot Gateway da deploy tren Vercel.
# Gia tri la ROOT URL (KHONG them /gateway/v1/notify).
TELEGRAM_GATEWAY_URL=https://your-telegram-bot.vercel.app
# Key cua Fall Detection tu bien GATEWAY_API_KEYS tren Vercel (>=24 ky tu).
TELEGRAM_GATEWAY_KEY=
ALERT_COOLDOWN_SECONDS=60

# Camera (giu lai gia tri cua ban neu da setup)
CCTV_URL=
CCTV_NAME=Camera phong khach
CCTV_AUTOSTART=0
CCTV_FALL_THRESHOLD=0.4
CCTV_CONFIRMATIONS=3
# 1: uu tien do tre thap cho RTSP/OpenCV; 0: dung cai dat mac dinh de xu ly su co
CCTV_LOW_LATENCY=1

# AI / GPU
FALL_DEVICE=auto
FALL_TORCH_CUDA_INDEX=cu126
