# Set admin password at least 12 characters; do not commit real passwords.
FALLGUARD_PASSWORD=
CCTV_URL=adb:back
CCTV_NAME=Android USB ADB
CCTV_AUTOSTART=1
CCTV_FALL_THRESHOLD=0.80
CCTV_CONFIRMATIONS=3
# BiLSTM: threshold applies to P(FALL) from 32 pose frames; confirm 3 adjacent windows.

# ADB: back/front camera on Android 12+, or adb:display for screen mirror.
ADB_DEVICE_SERIAL=
ADB_STREAM_PORT=27183
ADB_MAX_SIZE=1280
ADB_VIDEO_BIT_RATE=3000000
ADB_CAMERA_FPS=20

FALL_DEVICE=auto
FALL_TORCH_CUDA_INDEX=cu126
TELEGRAM_GATEWAY_URL=
# Path must match the route deployed by your Telegram gateway.
TELEGRAM_GATEWAY_PATH=/gateway/v1/notify
TELEGRAM_GATEWAY_KEY=
ALERT_COOLDOWN_SECONDS=60
