# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

# ==============================
# Virtual environments
# ==============================
.venv/
venv/
env/
ENV/

# ==============================
# Environment variables / secrets
# ==============================
.env
.env.*
!.env.example
!.env.*.example

# ==============================
# Runtime files generated by the app
# ==============================
uploads/*
outputs/*

# Keep placeholder files if you add them later
!uploads/.gitkeep
!outputs/.gitkeep

# ==============================
# Training / experiment artifacts
# Production model in models/ is NOT ignored
# ==============================
runs/
checkpoints/
wandb/

# ==============================
# Logs and temporary files
# ==============================
*.log
logs/
*.tmp
*.temp
*.bak

# ==============================
# Python tooling / test caches
# ==============================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ==============================
# Build / package artifacts
# ==============================
build/
dist/
*.egg-info/
.eggs/

# ==============================
# Jupyter
# ==============================
.ipynb_checkpoints/

# ==============================
# IDE / editor
# ==============================
.vscode/
.idea/
*.code-workspace

# ==============================
# OS files
# ==============================
.DS_Store
Thumbs.db
Desktop.ini

# ==============================
# Windows / Linux miscellaneous
# ==============================
$RECYCLE.BIN/
.Trash-*/
