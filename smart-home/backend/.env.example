# Copy thanh .env roi chinh sua
DATABASE_URL=sqlite:///./smarthome.db
# Set a private password with at least 12 characters in .env.
DASHBOARD_PASSWORD=
FALL_ENABLED=true
CCTV_URL=adb:back
CCTV_NAME=Camera phòng khách
CCTV_AUTOSTART=1
CCTV_FALL_THRESHOLD=0.80
CCTV_CONFIRMATIONS=3
FALL_DEVICE=auto
DEVICE_API_KEY=esp32-secret-key
CORS_ORIGINS=http://localhost:3000

# ---- MQTT (cau noi voi ESP32) ----
MQTT_ENABLED=true
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
# Phai trung voi prefix trong firmware ESP32 (ket thuc bang dau /)
MQTT_PREFIX=ptit_sh_k7x2q9/home/
# Giay khong nhan sensors thi coi ESP32 mat ket noi
MQTT_OFFLINE_AFTER=6
# Luu lich su cam bien vao database moi N giay (nen < 60)
MQTT_HISTORY_SECONDS=10
# true = tao thiet bi + luat + du lieu mau de demo giao dien (khi database trong)
SEED_DEMO=false

# --- Kết nối với Telegram ------
TELEGRAM_GATEWAY_URL=
TELEGRAM_GATEWAY_KEY=
TELEGRAM_GATEWAY_PATH=/gateway/v1/notify
