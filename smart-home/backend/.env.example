# Copy thanh .env roi chinh sua
DATABASE_URL=sqlite:///./smarthome.db
DEVICE_API_KEY=esp32-secret-key
CORS_ORIGINS=http://localhost:3000

# ---- MQTT (cau noi voi ESP32) ----
MQTT_ENABLED=true
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
# Phai trung voi prefix trong firmware ESP32 (ket thuc bang dau /)
MQTT_PREFIX=ptit_sh_k7x2q9/home/
# Giay khong nhan sensors thi coi ESP32 mat ket noi
MQTT_OFFLINE_AFTER=6
# Luu lich su cam bien vao database moi N giay (nen < 60)
MQTT_HISTORY_SECONDS=10
# true = tao thiet bi + luat + du lieu mau de demo giao dien (khi database trong)
SEED_DEMO=false
# true = TLS (port 8883), e.g. HiveMQ Cloud: MQTT_HOST=<cluster>.s1.eu.hivemq.cloud MQTT_PORT=8883
MQTT_TLS=false

# ---- Cloud time-series sink (Influx line protocol) ----
# Grafana Cloud: URL = <influx endpoint>/api/v1/push/influx/write, USER = instance ID, TOKEN = access policy token
# InfluxDB v2/v3: URL = https://<host>/api/v2/write?bucket=<bucket>&org=<org>&precision=ns, USER empty
CLOUD_SINK_ENABLED=false
CLOUD_SINK_URL=
CLOUD_SINK_USER=
CLOUD_SINK_TOKEN=
# Seconds between flushes, and max lines kept in memory while the cloud is unreachable
CLOUD_SINK_INTERVAL=10
CLOUD_SINK_MAX_BUFFER=10000

# ---- Local analytics pipeline ----
LAKE_DIR=data/lake
RAW_RETENTION_DAYS=7
ANOMALY_Z=3.0

# ---- Dashboard login (empty = no login, only safe on localhost) ----
DASHBOARD_PASSWORD=
# Empty = random per start (everyone logs in again after a restart)
AUTH_SECRET=
AUTH_TOKEN_HOURS=12
